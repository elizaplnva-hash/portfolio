---
import Base from '../../layouts/Base.astro';
import CaseProduct from '../../components/CaseProduct.astro';
import CaseVisual from '../../components/CaseVisual.astro';
import { cases } from '../../data/cases';
import '../../styles/case.css';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
---
<Base noindex={c.headline.startsWith('[') || ['world-of-colors', 'reboot-hub', 'bobyard'].includes(c.slug)} title={`${c.name}, ${c.headline} | Eliza Popelinova`} description={c.summary && !c.summary.startsWith('[') ? c.summary : c.headline} side={c.side}>
  {c.side === 'front' || c.screens ? <CaseProduct c={c} /> : <CaseVisual c={c} />}
</Base>
