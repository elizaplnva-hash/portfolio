---
import { icon } from '../data/icons';
interface Props { cols: string[]; rows: { label: string; a: boolean; b: boolean }[]; }
const { cols, rows } = Astro.props;
const mark = (v: boolean) => icon(v ? 'circle-check' : 'circle-x');
---
<div class="cmp scope c2">
  <div class="cmp-h"><span></span><span class="tg">{cols[0]}</span><span class="tg">{cols[1]}</span></div>
  {rows.map((r) => (
    <div class="cmp-r">
      <span class="nm">{r.label}</span>
      <i class:list={['on', r.a ? 'keep' : 'cut']} role="img" aria-label={r.a ? 'Yes' : 'No'} set:html={mark(r.a)} />
      <i class:list={['on', r.b ? 'keep' : 'cut']} role="img" aria-label={r.b ? 'Yes' : 'No'} set:html={mark(r.b)} />
    </div>
  ))}
</div>
