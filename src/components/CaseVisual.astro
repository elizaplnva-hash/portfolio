---
import type { CaseData, Ph } from '../data/cases';
import NextCase from './NextCase.astro';
interface Props { c: CaseData; }
const { c } = Astro.props;
const shots: Ph[] = c.shots ?? [1, 2, 3, 4].map((n) => ({ label: `Image ${n}`, spec: '' }));
const total = shots.length;
---
<div class="cv" style={`--c:${c.color}`}>
  <a href="/visual" class="cv-home">Eliza Popelinova</a>
  <a href="/visual" class="cv-close">Close</a>

  <div class="cv-stage" aria-hidden="true">
    <div class="cv-bg on" data-i="0">{c.image && <img src={c.image} alt="" />}</div>
    {shots.map((s, i) => (
      <div class="cv-bg" data-i={i + 1}>
        <figure class="cv-frame">{s.src ? <img src={s.src} alt={s.alt ?? ''} loading="lazy" /> : <figcaption>{s.label}</figcaption>}</figure>
      </div>
    ))}
  </div>

  <section class="cv-intro" data-i="0">
    <h1>{c.name}</h1>
    <dl class="cv-meta">
      {c.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      <div><dt>Focus</dt><dd>{c.tags.join(', ')}</dd></div>
    </dl>
    <p class="cv-lede">{c.summary}</p>
  </section>

  {shots.map((s, i) => (
    <section class="cv-shot" data-i={i + 1} aria-label={s.label}>
      <p class="cv-count">{i + 1} <span></span> {total}</p>
    </section>
  ))}

  <nav class="cv-thumbs" aria-label="Images">
    <a href="#top" data-i="0" class="on" aria-label="Intro"></a>
    {shots.map((s, i) => <a href="#top" data-i={i + 1} aria-label={s.label}></a>)}
  </nav>

  <div class="cv-end"><NextCase current={c} /></div>
</div>

<script>
  const secs = [...document.querySelectorAll<HTMLElement>('.cv-intro, .cv-shot')];
  const bgs = [...document.querySelectorAll<HTMLElement>('.cv-bg')];
  const th = [...document.querySelectorAll<HTMLAnchorElement>('.cv-thumbs a')];
  const set = (i: string) => {
    bgs.forEach((b) => b.classList.toggle('on', b.dataset.i === i));
    th.forEach((a) => a.classList.toggle('on', a.dataset.i === i));
  };
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).dataset.i!)), { threshold: 0.55 });
  secs.forEach((s) => io.observe(s));
  const end = document.querySelector('.cv-end');
  if (end) new IntersectionObserver((es) => es.forEach((e) => document.querySelector('.cv')?.classList.toggle('at-end', e.isIntersecting)), { threshold: 0.2 }).observe(end);
  th.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    secs.find((s) => s.dataset.i === a.dataset.i)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }));
</script>
