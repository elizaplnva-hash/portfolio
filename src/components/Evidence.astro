---
interface Shot { src: string; name: string; alt: string }
interface Frame { stats?: { items: { value: string; scope: string; text: string }[]; source: string }; shots?: { items: Shot[]; note: string; wide?: boolean; credit?: string } }
interface Props { frames: Frame[] }
const { frames } = Astro.props;
---
<div class="pn ev">
  {frames.map((f, i) => (
    <div class:list={['ev-f', { on: i === 0 }]}>
      {f.stats && <div class="ev-s">
        {f.stats.items.map((s, k) => (
          <div class:list={['ev-c', { sub: k > 0 }]}>
            <span class="ev-sc">{s.scope}</span>
            <b class="ev-v">{s.value}</b>
            <p>{s.text}</p>
          </div>
        ))}
        <p class="ev-src">{f.stats.source}</p>
      </div>}
      {f.shots && <div class:list={['ev-p', { wide: f.shots.wide }]}>
        <div class="ev-g">
          {f.shots.items.map((s) => <figure><img src={s.src} alt={s.alt} loading="lazy" decoding="async" /><figcaption>{s.name}</figcaption></figure>)}
        </div>
        <p class="ev-src">{f.shots.note}{f.shots.credit && <span> {f.shots.credit}</span>}</p>
      </div>}
    </div>
  ))}
</div>
