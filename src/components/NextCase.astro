---
import { cases, bySide, type CaseData } from '../data/cases';
interface Props { current: CaseData; }
const { current } = Astro.props;
const list = bySide(current.side);
const next = list[(list.findIndex((c) => c.slug === current.slug) + 1) % list.length];
const other = current.side === 'front'
  ? { href: '/visual', small: 'Seen enough screens?', big: 'Now the brand work' }
  : { href: '/', small: 'Curious how I design products?', big: 'Flip to the front' };
---
<section class="next" aria-label="Next">
  <a href={`/work/${next.slug}`} class="tile" style={`--c:${next.color}`}>
    <div class="art">{next.image && <img src={next.image} alt="" loading="lazy" />}</div>
    <div class="meta">
      <small>Next case</small>
      <div class="tags"><span>{next.name}</span>{next.tags.map((t) => <span>{t}</span>)}</div>
      <h2>{next.headline}</h2>
    </div>
  </a>
  <a href={other.href} class="tile turn" aria-label={other.small}>
    <small>{other.small}</small>
    <h2>{other.big}</h2>
    <span class="curl" aria-hidden="true"></span>
  </a>
</section>
