---
import { readFileSync } from 'node:fs';
import { icon } from '../data/icons';
interface Props { items: { tag: string; text: string; source: 'appstore' | 'reddit' | 'github'; meta: string }[]; }
const { items } = Astro.props;
const reddit = readFileSync(`${process.cwd()}/node_modules/@tabler/icons/icons/outline/brand-reddit.svg`, 'utf8').replace(/<!--[\s\S]*?-->/g, '').trim();
const ico = { appstore: icon('brand-apple'), github: icon('brand-github'), reddit };
const label = { appstore: 'App Store', github: 'GitHub', reddit: 'Reddit' };
const cols = [items.filter((_, i) => i % 2 === 0), items.filter((_, i) => i % 2 === 1)];
---
<div class="rvs">
  {cols.map((col) => (
    <div class="rv-col">
      {col.map((r) => (
        <figure class="rv-c" title={r.meta}>
          <i class={`src ${r.source}`} role="img" aria-label={label[r.source]} set:html={ico[r.source]} />
          <blockquote>{r.text}</blockquote>
        </figure>
      ))}
    </div>
  ))}
</div>
