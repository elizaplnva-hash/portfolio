---
// Brand showcase template: narrow menu, full-screen visual grids, About card on top of the visuals (see claude/case-structure.md)
import { bySide, type CaseData as Case } from '../data/cases';
import { icon } from '../data/icons';
import NextCase from './NextCase.astro';
const { c } = Astro.props as { c: Case };
const s = c.show!;
const home = '/brand';
const list = bySide(c.side);
const nextCase = list[(list.findIndex((k) => k.slug === c.slug) + 1) % list.length];
const nextCs = nextCase && nextCase.slug !== c.slug ? nextCase : undefined;
const chapters = s.screens.reduce<{ ch: string; id: string }[]>((a, x) => { const ch = x.ch ?? x.nav; if (ch !== 'Next' && !a.some((k) => k.ch === ch)) a.push({ ch, id: x.id }); return a; }, []);
const credIcon: Record<string, string> = { 'My role': 'briefcase', Team: 'user', Agency: 'building', Year: 'calendar' };
const face = { src: '/images/eliza-dark.webp', pos: '50% 12%' };
const mail = 'mailto:elizaplnva@gmail.com';
---
<div class="sc" data-sc>
  <aside class="sc-menu">
    <div class="sc-top">
      <a class="sc-back" href={home}>Back</a>
      <button class="sc-about-sw" type="button" role="switch" aria-checked="false"><span>About</span><i aria-hidden="true"></i></button>
    </div>
    <nav class="sc-nav" aria-label="Chapters">{chapters.map((k) => <a href={`#${k.id}`} data-for={k.id} data-ch={k.ch}>{k.ch}</a>)}</nav>
    <div class="sc-me"><span class="face" aria-hidden="true"><img src={face.src} alt="" width="40" height="40" decoding="async" style={`object-position:${face.pos}`} /></span><a href={mail} class="sc-talk">Let’s talk</a></div>
  </aside>

  <div class="sc-main" tabindex="-1">
    {s.screens.map((x) => (
      <section class:list={['sc-screen', x.kind]} id={x.id} data-ch={x.ch ?? x.nav} style={`--tone:${x.tone}`}>
        {x.kind === 'intro' && <div class="sc-cell sc-twin">{x.twin!.map((t, k) => <div class="tw"><img src={t} alt={k === 0 ? x.alt : ''} decoding="async" /></div>)}</div>}
        {x.kind === 'full' && <div class="sc-cell sc-full"><img src={x.src} alt={x.alt} decoding="async" /></div>}
        {x.kind === 'slide' && <div class="sc-cell sc-slide"><img src={x.src} alt={x.alt} decoding="async" /></div>}
        {(x.kind === 'v2a' || x.kind === 'v3s' || x.kind === 'v2s' || x.kind === 'v3h' || x.kind === 'v3l' || x.kind === 'v4d' || x.kind === 'v3c') && x.cells!.map((p) => <div class:list={['sc-cell', 'sc-ph', { fit: p.fit }]} style={p.bg ? `background:${p.bg}` : undefined}>{p.src ? <img src={p.src} alt={p.alt ?? ''} decoding="async" style={p.pos ? `object-position:${p.pos}` : undefined} /> : <><b>{p.label}</b><span>{p.spec}</span></>}</div>)}
        {x.kind === 'outro' && <>
          <div class="sc-cell sc-cta">
            <h2>Let’s carry your brand <em>from the van to the website</em></h2>
            <p>One identity that holds up on a sticker, a polo and a booking form, wherever customers meet it.</p>
            <a class="sc-btn" href={mail}>Let’s talk</a>
          </div>
          <div class="sc-tiles"><NextCase current={c} /></div>
        </>}
        {x.title && <div class="sc-card" aria-live="polite">
          <h2 set:html={x.title} />
          <p>{x.lede}</p>
          {x.id === s.screens[0].id && <ul class="sc-cred">{s.about.credits.map((m) => <li><span class="ic" set:html={icon(credIcon[m.label] ?? 'circle')} aria-hidden="true" /><span class="lb">{m.label}</span>{m.value}</li>)}</ul>}
          {x.link && <a class="sc-btn" href={x.link.href} target="_blank" rel="noopener">{x.link.label}</a>}
        </div>}
      </section>
    ))}
  </div>

</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-sc]');
  if (root) {
    const sw = root.querySelector<HTMLButtonElement>('.sc-about-sw')!;
    const set = (on: boolean) => { sw.setAttribute('aria-checked', String(on)); root.classList.toggle('about-on', on); };
    sw.addEventListener('click', () => set(sw.getAttribute('aria-checked') !== 'true'));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && sw.getAttribute('aria-checked') === 'true') set(false); });
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.sc-nav a')];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.ch === (e.target as HTMLElement).dataset.ch)); }), { root: root.querySelector('.sc-main'), threshold: 0.55 });
    root.querySelectorAll('.sc-screen').forEach((el) => io.observe(el));
    if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) root.querySelectorAll<HTMLElement>('.next .turn').forEach((turn) => {
      turn.addEventListener('pointermove', (e) => { const r = turn.getBoundingClientRect(); const d = Math.hypot(r.right - e.clientX, r.bottom - e.clientY) / Math.hypot(r.width, r.height); turn.style.setProperty('--curl', Math.round(58 + 70 * Math.max(0, 1 - d * 1.4)) + 'px'); });
      turn.addEventListener('pointerleave', () => turn.style.setProperty('--curl', '58px'));
    });
    links.forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); document.getElementById(a.dataset.for!)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); }));
  }
</script>

<style is:global>
  html:has(.sc), body:has(.sc) { background: #0b0b0a; overflow: hidden; }
  .sc { --ink: #f2f2f2; --muted: #8f8a83; --chip: #262523; --sel: rgba(66, 64, 61, .82); --menu: 200px; --gap: 8px; position: fixed; inset: 0; display: grid; grid-template-columns: var(--menu) 1fr; color: var(--ink); font-family: 'Manrope Variable', 'Helvetica Neue', Arial, sans-serif; letter-spacing: -.02em; }
  .sc a { color: inherit; text-decoration: none; }
  .sc-menu { display: flex; flex-direction: column; justify-content: space-between; padding: 24px 14px 20px; min-height: 0; }
  .sc-top { display: flex; gap: 6px; align-items: center; }
  .sc-back, .sc-about-sw, .sc-talk { padding: 8px 14px; border-radius: 999px; background: var(--chip); font-size: 14px; transition: background .3s, color .3s; }
  .sc-about-sw { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 12px; border: 0; color: var(--ink); font: inherit; font-size: 14px; cursor: pointer; }
  .sc-about-sw i { width: 28px; height: 18px; border-radius: 999px; background: #3a3835; position: relative; transition: background .3s; }
  .sc-about-sw i::after { content: ''; position: absolute; top: 3px; left: 3px; width: 12px; height: 12px; border-radius: 50%; background: #f2f2f2; transition: transform .3s; }
  .sc-about-sw[aria-checked='true'] i { background: #6fb04a; }
  .sc-about-sw[aria-checked='true'] i::after { transform: translateX(10px); }
  .sc-nav { display: flex; flex-direction: column; gap: 2px; }
  .sc-nav a { padding: 7px 12px; border-radius: 999px; font-size: 14px; color: var(--muted); transition: background .3s, color .3s; }
  .sc-nav a.on { background: var(--sel); color: var(--ink); }
  .sc-me { display: flex; align-items: center; gap: 8px; }
  .sc-me .face { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; flex: none; }
  .sc-me .face img { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) { .sc-back:hover, .sc-about-sw:hover, .sc-talk:hover, .sc-btn:hover { background: #c6ef7e; color: #13230f; } .sc-nav a:not(.on):hover { color: var(--ink); } }
  .sc-main { height: 100dvh; overflow-y: auto; scroll-snap-type: y mandatory; scrollbar-width: none; }
  .sc-main::-webkit-scrollbar { display: none; }
  .sc-screen { height: 100dvh; min-height: 600px; scroll-snap-align: start; padding: var(--gap) var(--gap) var(--gap) 0; display: grid; gap: var(--gap); position: relative; }
  .sc-cell { border-radius: 12px; background: var(--tone); overflow: hidden; position: relative; min-height: 0; }
  .sc-screen.intro, .sc-screen.slide { grid-template-columns: 1fr; }
  .sc-twin { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr); gap: 24px; padding: 0 12%; overflow: hidden; }
  .sc-twin .tw { position: relative; overflow: hidden; align-self: start; height: calc(100% + 12vh); transform-origin: 50% 0; transition: transform .55s cubic-bezier(.22,1,.36,1); }
  @media (hover: hover) and (pointer: fine) { .sc-twin:hover .tw { transform: scale(.975); } .sc-twin:hover .tw:hover { transform: scale(1.035); z-index: 2; } }
  .sc-twin img { position: absolute; left: 0; top: 0; width: 100%; height: auto; }
  .sc-twin .tw:first-child img { top: 8%; border-radius: 12px 12px 0 0; }
  .sc-screen.full { grid-template-columns: 1fr; }
  .sc-full img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  @media (hover: hover) and (pointer: fine) { .sc-full:hover img { transform: scale(1.02); } }
  .sc-slide { display: grid; place-items: center; container-type: size; }
  .sc-slide img { width: min(100cqw - 8cqw, (100cqh - 8cqw) * 16 / 9); height: auto; border-radius: 12px; transition: transform .55s cubic-bezier(.22,1,.36,1); }
  @media (hover: hover) and (pointer: fine) { .sc-slide:hover img { transform: scale(1.025); } }
  .sc-screen.v2a { grid-template-columns: 1fr 1fr; }
  .sc-screen.v3h { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .sc-screen.v3h .sc-ph:nth-child(3) { grid-column: 2; grid-row: 1 / 3; }
  .sc-screen.v3l { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .sc-screen.v3l .sc-ph:nth-child(1) { grid-column: 1; grid-row: 1 / 3; }
  .sc-cred { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 14px 0 0; padding: 12px 0 0; border-top: 1px solid rgba(255,255,255,.12); list-style: none; font-size: 12.5px; color: #e8e4dd; }
  .sc-cred li { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .sc-cred .lb { color: #a8a39b; }
  .sc-cred .ic { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: rgba(169,224,142,.16); color: #a9e08e; }
  .sc-cred .ic svg { width: 12px; height: 12px; }
  .sc-cred .ic svg:not([fill='none']) { fill: currentColor; }
  .sc-cred .ic svg[fill='none'] { stroke-width: 2.4; }
  .sc-screen.v2s { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
  .sc-ph.fit img { object-fit: contain; }
  .sc-screen.v3s { grid-template-columns: 7fr 4fr; grid-template-rows: 1fr 1fr; }
  .sc-screen.v3s .sc-ph:nth-child(1) { grid-column: 1; grid-row: 1; }
  .sc-screen.v3s .sc-ph:nth-child(2) { grid-column: 1; grid-row: 2; }
  .sc-screen.v3s .sc-ph:nth-child(3) { grid-column: 2; grid-row: 1 / 3; }
  .sc-screen.v4d { grid-template-columns: repeat(3, 1fr); grid-template-rows: 3fr 2fr; }
  .sc-screen.v3c { grid-template-columns: 1fr 1fr; grid-template-rows: 3fr 2fr; }
  .sc-screen.v4d .sc-ph:first-child, .sc-screen.v3c .sc-ph:first-child { grid-column: 1 / -1; }
  .sc-screen.outro { grid-template-columns: 6fr 5fr; }
  .sc-cta { background: #1c1b1a; padding: 48px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .sc-cta h2 { margin: 0 0 18px; max-width: 13em; font-size: clamp(32px, 3.4vw, 50px); line-height: 1.04; font-weight: 700; letter-spacing: -.045em; text-wrap: balance; }
  .sc-cta h2 em { font-style: normal; color: #a9e08e; }
  .sc-cta p { margin: 0 0 28px; max-width: 420px; color: #b8b3ab; font-size: 16px; line-height: 1.45; text-wrap: balance; }
  .sc-cta .sc-btn { margin: 0; padding: 12px 22px; font-size: 15px; background: var(--chip); }
  .sc-tiles { min-height: 0; }
  .sc-tiles .next { display: grid; grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap); height: 100%; }
  .sc-tiles .next .tile { min-height: 0; overflow: hidden; border-radius: 12px; }
  .sc-tiles .next .tile:not(.turn) { background: #1c1b1a; color: var(--ink); display: flex; flex-direction: column; gap: 12px; padding: 12px; }
  .sc-tiles .next .art { flex: 1; aspect-ratio: auto; min-height: 0; background: color-mix(in srgb, var(--c) 30%, #1c1b1a); }
  .sc-tiles .next .art img { opacity: 1; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  .sc-tiles .next .art .lbl { display: none; }
  .sc-tiles .next .tile:not(.turn) h2 { margin: 0; font-size: clamp(18px, 1.6vw, 24px); font-weight: 600; letter-spacing: -.03em; color: var(--ink); }
  .sc .sc-tiles .next .turn { color: var(--on-accent, #111); }
  .sc-tiles .next .turn { position: relative; justify-content: space-between; padding: 26px 28px; }
  .sc-tiles .next .turn h2 { margin: 0; color: inherit; }
  .sc-tiles .next .meta { padding: 0 6px 6px; }
  @media (hover: hover) and (pointer: fine) { .sc-tiles .next .tile:not(.turn):hover .art img { transform: scale(1.03); } }
  .sc-ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-align: center; padding: 24px; color: rgba(255,255,255,.78); }
  .sc-ph b { font-size: 18px; font-weight: 600; color: #fff; }
  .sc-ph span { font-size: 13px; max-width: 280px; line-height: 1.4; }
  .sc-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  @media (hover: hover) and (pointer: fine) { .sc-ph:hover img { transform: scale(1.03); } }
  .sc-next { display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; padding: 24px; background: var(--chip); transition: background .3s, color .3s; }
  .sc-next img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .38; }
  .sc-next span, .sc-next b { position: relative; }
  .sc-next span { font-size: 13px; opacity: .75; }
  .sc-next b { font-size: clamp(20px, 1.9vw, 28px); line-height: 1.1; font-weight: 700; letter-spacing: -.035em; }
  @media (hover: hover) and (pointer: fine) { .sc-next:hover { background: #c6ef7e; color: #13230f; } }
  .sc-card { position: absolute; left: 24px; bottom: 32px; z-index: 3; width: calc((100% - 8px) / 2 - 24px); padding: 24px 28px; border-radius: 12px; background: var(--sel); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); opacity: 0; transform: translateY(8px); pointer-events: none; transition: opacity .25s ease-out, transform .25s ease-out; }
  .about-on .sc-card { opacity: 1; transform: none; pointer-events: auto; }
  .sc-card h2 { margin: 0 0 10px; font-size: clamp(22px, 2vw, 30px); line-height: 1.15; font-weight: 700; letter-spacing: -.03em; }
  .sc-card h2 em { font-style: normal; color: #a9e08e; }
  .sc-card p { margin: 0; color: #d8d4cd; font-size: clamp(14px, 1.1vw, 17px); line-height: 1.45; }
  .sc-btn { display: inline-block; margin-top: 14px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.12); font-size: 13px; transition: background .3s, color .3s; }
  @media (prefers-reduced-motion: reduce) { .sc * { transition: none !important; transform: none !important; } }
  @media (max-width: 767px) {
    html:has(.sc), body:has(.sc) { overflow: auto; }
    .sc { position: static; display: block; }
    .sc-menu { flex-direction: row; align-items: center; padding: 12px; position: sticky; top: 0; z-index: 6; background: #0b0b0a; }
    .sc-nav, .sc-me { display: none; }
    .sc-main { height: auto; overflow: visible; scroll-snap-type: none; }
    .sc-screen { height: auto; min-height: 0; padding: 8px; grid-template-columns: 1fr !important; grid-template-rows: none !important; }
    .sc-cell { min-height: 280px; }
    .sc-cell.sc-twin { min-height: 460px; }
    .sc-screen .sc-ph:first-child { grid-column: auto !important; }
    .sc-card { position: static; width: auto; margin-top: 4px; display: none; }
    .about-on .sc-card { display: block; }
  }
</style>
