---
import { sides, type Side } from '../data/site';
import Icon from './Icon.astro';
interface Props { side: Side; }
const { side } = Astro.props;
const s = sides[side];
// case colours only, so no new accent appears
const hues = ['#E0408F', '#5B6EF0', '#E58A1F', '#22A55E'];
---
<main class="sheet">
  <a href="#" class="tile photo has-img" aria-label="About Eliza Popelinova">
    <img src={s.photo} alt="Eliza Popelinova" width="1200" height="960" decoding="async" style={`object-position:${s.photoPos}`} />
    <div class="chips">
      <span class="pill light"><svg class="globe" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><g class="spin"><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></g></svg>Vancouver, BC</span>
      <span class="pill light"><span class="dot"></span>Open to work</span>
    </div>
    <h1 class="name">Eliza Popelinova</h1>
  </a>

  <section class="tile pitch">
    <span class="tag">About</span>
    <div class="lead">
      <h2 class="role">{s.role}</h2>
      <p class="motto">{s.pitch}</p>
      <p class="sub">{s.pitchSub}</p>
    </div>
    <nav class="socials" aria-label="Links">
      {s.socials.map((l) => (
        <a class="ico" data-kind={l.kind} href={l.href} aria-label={l.label} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}><Icon kind={l.kind} /></a>
      ))}
    </nav>
  </section>

  <section class="tile process" aria-labelledby="proc-h">
    <h2 id="proc-h" class="tag">My process</h2>
    <ol class="steps">
      <span class="pframe" aria-hidden="true"></span>
      {s.process.map((p) => (
        <li tabindex="0">
          <b>{p.title}</b>
          <p>{p.text}</p>
          <ul>{p.tags.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ol>
  </section>

  {s.cases.map((c, i) => (
    <a href={c.href} class:list={['tile', 'case', `case-${i + 1}`, { big: c.big }]} style={`--c:${c.color}`}>
      <div class="art" style={`view-transition-name:vt-${c.slug}`}>
        {c.image && <img src={c.image} alt="" loading="lazy" />}
        <div class="tags"><span>{c.name}</span>{c.tags.map((t) => <span>{t}</span>)}</div>
      </div>
      <div class="meta">
        <h2>{c.headline}</h2>
      </div>
    </a>
  ))}

  <a href={s.turn.href} class="tile turn" aria-label={s.turn.label}>
    <small>{s.turn.small}</small>
    <h2>{s.turn.big}</h2>
    <span class="curl" aria-hidden="true"></span>
  </a>
</main>
<script>
  // the photo drifts a little towards the cursor (mouse only, never with reduced motion)
  if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const ph = document.querySelector<HTMLElement>('.photo');
    ph?.addEventListener('pointermove', (e) => {
      const r = ph.getBoundingClientRect();
      ph.style.setProperty('--px', (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(2));
      ph.style.setProperty('--py', (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(2));
    });
    ph?.addEventListener('pointerleave', () => { ph.style.setProperty('--px', '0'); ph.style.setProperty('--py', '0'); });
  }
</script>

<style is:global>
/* switching sides: the other side is revealed from the page-curl corner */
@view-transition { navigation: auto; }
::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
::view-transition-old(root) { z-index: 1; }
::view-transition-new(root) { z-index: 2; animation: reveal .8s cubic-bezier(.65, 0, .2, 1) both; }
@keyframes reveal {
  from { clip-path: circle(0 at 100% 100%); }
  to { clip-path: circle(150vmax at 100% 100%); }
}

/* opening and closing a case: the cover grows out of its tile, the rest fades */
:root:active-view-transition-type(case)::view-transition-old(root) { animation: vt-out .28s ease-out both; }
:root:active-view-transition-type(case)::view-transition-new(root) { animation: vt-in .45s .12s ease-out both; clip-path: none; z-index: 1; }
:root:active-view-transition-type(case)::view-transition-group(*) { animation-duration: .65s; animation-timing-function: cubic-bezier(.22, 1, .36, 1); }
:root:active-view-transition-type(case)::view-transition-old(*):not(:root), :root:active-view-transition-type(case)::view-transition-new(*):not(:root) { height: 100%; object-fit: cover; }
:root:active-view-transition-type(case)::view-transition-group(root) { animation-duration: .45s; }
@keyframes vt-out { to { opacity: 0; } }
@keyframes vt-in { from { opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  ::view-transition-new(root), :root:active-view-transition-type(case)::view-transition-new(root), :root:active-view-transition-type(case)::view-transition-old(root) { animation: none; }
  :root:active-view-transition-type(case)::view-transition-group(*) { animation-duration: .01s; }
}
</style>
