---
import type { CaseData, Screen } from '../data/cases';
import NextCase from './NextCase.astro';
import { icon, metaIcon } from '../data/icons';
interface Props { c: CaseData; }
const { c } = Astro.props;

const generic: Screen[] = [
  { id: 'overview', nav: 'Overview', title: [c.headline], lede: c.summary,
    blocks: [{ type: 'meta', items: c.facts.map((f) => ({ label: f.label, value: f.value })) }],
    visual: { layout: 'single', items: [{ label: 'Cover', spec: 'The product on its home screen.' }] } },
  { id: 'problem', nav: 'Problem', title: ['[What was broken,', 'in one line.]'],
    visual: { layout: 'single', items: [{ label: 'The problem', spec: 'A screen or a quote that proves it.' }] } },
  { id: 'insight', nav: 'Insight', statement: true, title: ['[The one insight', 'everything rests on.]'] },
  { id: 'decisions', nav: 'Decisions', title: ['[The decision', 'that mattered.]'],
    blocks: [{ type: 'decision', rows: [['Decision', '[What you decided]'], ['Chose', '[X over Y]'], ['Because', '[Why]']] }],
    visual: { layout: 'stack', items: [{ label: 'Detail', spec: '' }, { label: 'Detail', spec: '' }, { label: 'Key screen', spec: '' }] } },
  { id: 'outcome', nav: 'Outcome', title: ['[What shipped', 'and what changed.]'],
    visual: { layout: 'single', items: [{ label: 'Final frame', spec: '' }] } },
];
const screens = c.screens ?? generic;
const tone = `--c:${c.fill ?? c.color};--a:${c.accent ?? `color-mix(in oklab, ${c.color} 70%, #000)`};--af:${c.fill ?? c.color};--t:${c.tint ?? '#f1f1ef'}`;
const mail = 'mailto:elizaplnva@gmail.com';
---
<div class="cp-story" style={tone}>
  <header class="m-bar">
    <a href="/" class="back"><span class="ar" aria-hidden="true" set:html={icon('arrow-left')} />Back</a>
    <div class="me-row"><span class="face" aria-hidden="true">EP</span><a href={mail} class="btn contact">Contact</a></div>
  </header>

  <div class="story">
    <nav class="rail" aria-label="Case sections">
      <a href="/" class="back"><span class="ar" aria-hidden="true" set:html={icon('arrow-left')} /><span class="roll"><span data-t="Back">Back</span></span></a>
      <ol>
        {screens.map((s) => <li><a href={`#${s.id}`} data-step={s.id}><span class="roll"><span data-t={s.nav}>{s.nav}</span></span></a></li>)}
      </ol>
      <div class="me-row"><span class="face" aria-hidden="true">EP</span><a href={mail} class="btn contact"><span class="roll"><span data-t="Contact">Contact</span></span></a></div>
    </nav>

    <div class="frame" aria-hidden="true"></div>
    <div class="steps">
      {screens.map((s, si) => (
        <section class:list={['step', { statement: s.statement }]} id={s.id} data-step={s.id}>
          {s.visual && (
            <div class:list={['m-vis', `v-${s.visual.layout}`]}>
              {s.visual.items.map((p) => <figure class="ph"><b>{p.label}</b>{p.spec && <p>{p.spec}</p>}</figure>)}
            </div>
          )}
          <div class="step-text">
            {si === 0 && <div class="tags rv"><span>{c.name}</span>{c.tags.map((t) => <span>{t}</span>)}</div>}
            {si === 0
              ? <h1 class="ttl rv">{s.title[0]} {s.title[1] && <em>{s.title[1]}</em>}</h1>
              : s.statement
                ? <h2 class="ttl"><span class="ln">{s.title[0]}</span> {s.title[1] && <em class="ln">{s.title[1]}</em>}</h2>
                : <h2 class="ttl rv">{s.title[0]} {s.title[1] && <em>{s.title[1]}</em>}</h2>}
            {s.lede && <p class="lede rv">{s.lede}</p>}

            {s.blocks?.map((b) => {
              switch (b.type) {
                case 'meta': return (
                  <ul class="meta rv">{b.items.map((m) => (
                    <li><span class="ic" aria-hidden="true" set:html={icon(metaIcon[m.label] ?? 'circle-check')} /><span><small>{m.label}</small><b>{m.value}</b></span></li>))}
                  </ul>);
                case 'bento': return (
                  <div class="bento rv">{b.cells.map((x) => (
                    <div class:list={['cell', 'lift', x.fill ? 'l1 hi' : 'l2', { wide: x.wide }]}>
                      {x.icon && <span class="ic" aria-hidden="true" set:html={icon(x.icon)} />}
                      <h3>{x.title}</h3>
                      {x.body && <p>{x.body}</p>}
                    </div>))}
                  </div>);
                case 'contrast': return (
                  <div class="contrast rv">
                    <div class="from l3 lift"><p>{b.from.label}</p><ul>{b.from.items.map((t) => <li>{t}</li>)}</ul></div>
                    <div class="to l1 hi lift"><p>{b.to.label}</p><ul>{b.to.items.map((t, i) => <li>{b.to.icons?.[i] && <span class="ic" aria-hidden="true" set:html={icon(b.to.icons[i])} />}{t}</li>)}</ul></div>
                  </div>);
                case 'table': return (
                  <table class="tbl rv">
                    <thead><tr><th>{b.head[0]}</th><th>{b.head[1]}</th></tr></thead>
                    <tbody>{b.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td></tr>)}</tbody>
                  </table>);
                case 'decision': return (
                  <dl class="decision rv">{b.rows.map((r) => <div><dt>{r[0]}</dt><dd>{r[1]}</dd></div>)}</dl>);
                case 'cards': return (
                  <div class="cards rv">{b.items.map((x) => (
                    <div class:list={['cell', 'lift', x.hi ? 'l1 hi' : 'l2']}>
                      {x.icon && <span class="ic" aria-hidden="true" set:html={icon(x.icon)} />}
                      {x.label && <small>{x.label}</small>}<h3>{x.title}</h3>{x.body && <p>{x.body}</p>}
                    </div>))}
                  </div>);
                case 'list': return (
                  <ol class:list={['list rv', { num: b.numbered }]}>{b.items.map((x) => (
                    <li>
                      {x.icon ? <span class="ic" aria-hidden="true" set:html={icon(x.icon)} /> : b.numbered ? <span class="n" aria-hidden="true"></span> : null}
                      <div>{x.label && <small>{x.label}</small>}<h3>{x.title}</h3>{x.body && <p>{x.body}</p>}</div>
                    </li>))}
                  </ol>);
                case 'callout': return <p class="callout rv">{b.text}</p>;
                case 'chain': return (
                  <ol class="chain rv">{b.steps.map((t, i) => (
                    <li><span class:list={['pill', i === b.steps.length - 1 ? 'l1 last' : 'l2']}>{t}</span>{i < b.steps.length - 1 && <span class="ar" aria-hidden="true" set:html={icon('arrow-down')} />}</li>))}
                  </ol>);
                case 'chips': return (
                  <ul class="chips big rv">{b.items.map((t) => <li>{t}</li>)}</ul>);
                case 'facts': return (
                  <div class="facts rv"><small>{b.caption}</small>
                    <dl>{b.items.map((f) => <div class="l2 lift"><dd>{f.value}</dd><dt>{f.label}</dt></div>)}</dl>
                  </div>);
                case 'note': return <p class="note rv">{b.text}</p>;
                case 'fromto': return (
                  <dl class="fromto rv"><div class="l3 lift"><dt>From</dt><dd>{b.from}</dd></div><div class="l1 hi lift"><dt>To</dt><dd>{b.to}</dd></div></dl>);
                case 'steps': return (
                  <ol class="list num rv">{b.items.map((x) => <li><span class="n" aria-hidden="true"></span><div><h3>{x.title}</h3><p>{x.body}</p></div></li>)}</ol>);
                case 'quote': return (<figure class="quote rv"><blockquote>“{b.text}”</blockquote><figcaption>{b.by}</figcaption></figure>);
                case 'theme': return (
                  <div class="theme rv" role="group" aria-label="Screen theme">
                    <button type="button" aria-pressed="true" data-theme="light">Light</button>
                    <button type="button" aria-pressed="false" data-theme="dark">Dark</button>
                  </div>);
              }
            })}
          </div>
        </section>
      ))}
      <section class="step cta-step" id="next" data-step="next">
        <div class="step-text">
          <h2 class="ttl rv">Let’s talk.</h2>
          <a href={mail} class="cta rv"><span class="roll"><span data-t="elizaplnva@gmail.com">elizaplnva@gmail.com</span></span></a>
        </div>
      </section>
    </div>

    <div class="stage">
      {screens.map((s, i) => s.visual && (
        <div class:list={['vis', `v-${s.visual.layout}`, { on: i === 0 }]} data-step={s.id} aria-hidden="true">
          {s.visual.items.map((p) => <figure class="ph"><b>{p.label}</b>{p.spec && <p>{p.spec}</p>}</figure>)}
        </div>
      ))}
      <div class="vis nx" data-step="next"><NextCase current={c} /></div>
    </div>
  </div>

  <section class="end"><NextCase current={c} /></section>
</div>

<script>
  document.documentElement.classList.add('js');
  const steps = [...document.querySelectorAll<HTMLElement>('.step')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail a[data-step]')];
  const vis = [...document.querySelectorAll<HTMLElement>('.stage .vis')];
  const stage = document.querySelector<HTMLElement>('.stage');
  const set = (id: string) => {
    links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.step === id));
    let shown = false;
    vis.forEach((v) => { const on = v.dataset.step === id; v.classList.toggle('on', on); shown ||= on; });
    stage?.classList.toggle('empty', !shown);
  };
  // reveal: a screen's blocks rise once it is a little in view
  const rv = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rv.unobserve(e.target); } }), { rootMargin: '0px 0px -15% 0px' });
  steps.forEach((s) => rv.observe(s));
  if (steps[0]) set(steps[0].id);
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).id)), { rootMargin: '-45% 0px -45% 0px' });
  steps.forEach((s) => io.observe(s));

  // light / dark switch for the "every state" screens
  document.querySelectorAll<HTMLElement>('.theme').forEach((g) => {
    const step = g.closest<HTMLElement>('.step');
    g.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b || !step) return;
      g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const dark = b.dataset.theme === 'dark';
      document.querySelectorAll<HTMLElement>(`[data-step="${step.id}"].vis, #${step.id} .m-vis`).forEach((v) => v.classList.toggle('dark', dark));
    });
  });
</script>
