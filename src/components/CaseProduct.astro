---
import type { CaseData } from '../data/cases';
import NextCase from './NextCase.astro';
import IntroStats from './IntroStats.astro';
interface Props { c: CaseData; }
const { c } = Astro.props;
const placeholder = [
  { id: 'context', n: '01', title: 'Context', blocks: [{ type: 'text', paragraphs: ['[What the product is and who it is for.]', '[Your role and the team.]'] }, { type: 'figs', cols: 1, figs: [{ src: '', alt: '' }] }] },
  { id: 'problem', n: '02', title: 'Problem', blocks: [{ type: 'text', paragraphs: ['[What was not working, in one or two sentences.]', '[How you found out: research, data, interviews.]'] }, { type: 'figs', cols: 2, figs: [{ src: '', alt: '' }, { src: '', alt: '' }] }] },
  { id: 'process', n: '03', title: 'Process', blocks: [{ type: 'text', paragraphs: ['[Key decisions and why. Keep to the two or three that mattered.]'] }, { type: 'figs', cols: 2, figs: [{ src: '', alt: '' }, { src: '', alt: '' }] }] },
  { id: 'solution', n: '04', title: 'Solution', blocks: [{ type: 'text', paragraphs: ['[What you shipped, in plain words.]'] }, { type: 'figs', cols: 2, figs: [{ src: '', alt: '' }, { src: '', alt: '' }] }] },
  { id: 'outcome', n: '05', title: 'Outcome', blocks: [{ type: 'text', paragraphs: ['[What changed after launch.]', '[What you would do differently.]'] }] },
];
const sections = c.sections ?? placeholder;
---
<div class="cp cp-product">
  <aside class="tile side">
    <a href="/" class="home-link">Eliza<br />Popelinova</a>
    <nav aria-label="Sections" data-sections>
      {sections.map((s) => <a href={`#${s.id}`}><span>{s.n}</span>{s.title}</a>)}
    </nav>
    <p class="other"><a href="/">All product work</a><br /><a href="/visual">Brand &amp; visual work</a></p>
  </aside>

  <div class="main">
    <header class="tile hero">
      <div class="tags"><span>{c.name}</span>{c.tags.map((t) => <span>{t}</span>)}</div>
      <h1>{c.headline}</h1>
      <figure class:list={['fig', { 'has-img': !!c.image }]} style={`--c:${c.color}`}>{c.image ? <img src={c.image} alt={`${c.name} landing page`} /> : <figcaption>{c.name}, key screens</figcaption>}</figure>
    </header>

    {c.intro && c.stats && <IntroStats intro={c.intro} stats={c.stats} />}

    <section class="tile facts-tile" aria-label="Facts">
      <dl class="facts">{c.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
    </section>

    <section class="highlights" aria-label="Highlights">
      {c.highlights.map((h, i) => <div class="tile"><span>0{i + 1}</span><p>{h}</p></div>)}
    </section>

    {sections.map((s) => (
      <section class="tile sec" id={s.id}>
        <div class="head"><span>{s.n}</span><h2>{s.title}</h2></div>
        {s.blocks.map((b) => b.type === 'text' ? (
          <div class="text">
            {b.heading && <h3>{b.heading}</h3>}
            {b.paragraphs.map((t) => <p>{t}</p>)}
          </div>
        ) : (
          <div class={`figs cols-${b.cols}`}>
            {b.figs.map((f) => (
              <figure class:list={['fig', { 'has-img': !!f.src }]} style={`--c:${c.color}`}>
                {f.src && <img src={f.src} alt={f.alt} loading="lazy" />}
                {f.caption && <figcaption class="cap">{f.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ))}
      </section>
    ))}

    <NextCase current={c} />
  </div>
</div>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-sections] a')];
  const secs = links.map((a) => document.querySelector(a.hash)).filter(Boolean) as Element[];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.setAttribute('aria-current', String(a.hash === '#' + e.target.id)));
    });
  }, { rootMargin: '-35% 0px -55% 0px' });
  secs.forEach((s) => io.observe(s));
</script>
