---
import type { CaseData, Step } from '../data/cases';
import NextCase from './NextCase.astro';
interface Props { c: CaseData; }
const { c } = Astro.props;

const generic: Step[] = [
  { id: 'context', n: '01', title: 'Context', body: ['[What the product is and who it is for. Your role and the team.]'], table: { rows: [['Role', '[Role]'], ['Timeline', '[Timeline]'], ['Platform', '[Platform]'], ['Team', '[Team]']] }, visual: { label: 'Cover', spec: '[The product on its home screen.]' } },
  { id: 'problem', n: '02', title: 'Problem', body: ['[What was not working, in one or two sentences, and how you found out.]'], visual: { label: 'The problem', spec: '[A screen or a quote that proves it.]' } },
  { id: 'process', n: '03', title: 'Process', body: ['[The two or three decisions that mattered, and why.]'], table: { head: ['Decision', 'Why'], rows: [['[Decision]', '[Why]'], ['[Decision]', '[Why]']] }, visual: { label: 'Process', spec: '[Sketches, flows or the key screens.]' } },
  { id: 'solution', n: '04', title: 'Solution', body: ['[What you shipped, in plain words.]'], visual: { label: 'Solution', spec: '[The final screens.]' } },
  { id: 'outcome', n: '05', title: 'Outcome', body: ['[What changed after launch, and what you would do differently.]'], visual: { label: 'Outcome', spec: '[Results or a closing frame.]' } },
];
const steps = c.story ?? generic;
---
<div class="cp-story">
  <header class="screen hero">
    <a href="/" class="home-link">Eliza<br />Popelinova</a>
    <div class="hero-body">
      <div class="hero-text">
        <div class="tags"><span>{c.name}</span>{c.tags.map((t) => <span>{t}</span>)}</div>
        <h1>{c.headline}</h1>
        <ol class="points">
          {c.highlights.map((h, i) => <li><span>0{i + 1}</span><p>{h}</p></li>)}
        </ol>
      </div>
      <figure class="ph hero-ph" aria-label="Placeholder: cover">
        <b>Cover</b>
        <small>4:5 · 1400×1750</small>
        <p>The product’s main image: the light home screen, the strongest frame you have.</p>
      </figure>
    </div>
  </header>

  <div class="story">
    <nav class="rail" aria-label="Steps">
      <a href="/" class="home-link rail-home">Eliza<br />Popelinova</a>
      <ol>
        {steps.map((s) => <li><a href={`#${s.id}`} data-step={s.id}><span>{s.n}</span>{s.short ?? s.title}</a></li>)}
      </ol>
      <p class="other"><a href="/visual">Brand &amp; visual work</a></p>
    </nav>

    <div class="steps">
      {steps.map((s) => (
        <section class="step" id={s.id} data-step={s.id}>
          <figure class="ph m-ph" aria-label={`Placeholder: ${s.visual.label}`}>
            <b>{s.visual.label}</b><small>4:5 · 1400×1750</small><p>{s.visual.spec}</p>
          </figure>
          <div class="step-text">
            <span class="num">{s.n}</span>
            <h2>{s.title}</h2>
            {s.body.map((t) => <p>{t}</p>)}
            {s.table && (
              <table class="tbl">
                {s.table.head && <thead><tr>{s.table.head.map((h) => <th>{h}</th>)}</tr></thead>}
                <tbody>{s.table.rows.map((r) => <tr>{r.map((cell, i) => (i === 0 && !s.table!.head ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
              </table>
            )}
            {s.nums && <dl class="nums">{s.nums.map((n) => <div><dt>{n.label}</dt><dd>{n.value}</dd></div>)}</dl>}
          </div>
        </section>
      ))}
    </div>

    <div class="stage" aria-hidden="true">
      {steps.map((s, i) => (
        <figure class:list={['ph', { on: i === 0 }]} data-step={s.id}>
          <b>{s.visual.label}</b><small>4:5 · 1400×1750</small><p>{s.visual.spec}</p>
        </figure>
      ))}
    </div>
  </div>

  <section class="screen end"><NextCase current={c} /></section>
</div>

<script>
  const ids = [...document.querySelectorAll<HTMLElement>('.step')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail a[data-step]')];
  const figs = [...document.querySelectorAll<HTMLElement>('.stage figure')];
  const set = (id: string) => {
    links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.step === id));
    figs.forEach((f) => f.classList.toggle('on', f.dataset.step === id));
  };
  set(ids[0]?.id);
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set(e.target.id)), { rootMargin: '-50% 0px -50% 0px' });
  ids.forEach((s) => io.observe(s));
</script>
