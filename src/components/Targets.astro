---
interface Props { lead?: string; items: { value: string; of?: string; stage: string; metric: string; why: string }[]; note?: string; }
const { lead, items, note } = Astro.props;
---
<div class="tgs">
  {lead && <p class="tgs-lead">{lead}</p>}
  {items.map((it) => (
    <div class="tgs-r">
      <div class="n"><span class="v">{it.value}</span>{it.of && <small>{it.of}</small>}</div>
      <div class="t"><b>{it.metric}</b><p>{it.why}</p></div>
      <span class="tag">{it.stage}</span>
    </div>
  ))}
  {note && <p class="tgs-note">{note}</p>}
</div>
