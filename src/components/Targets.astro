---
interface Props { src?: string; alt?: string; items: { value: string; of?: string; stage: string; metric: string; why: string; y?: number }[]; }
const { src, alt = '', items } = Astro.props;
---
<div class="tgs shot">
  <div class="tgs-img">{src && <img src={src} alt={alt} loading="lazy" />}</div>
  {items.map((it) => (
    <div class="tgs-r" style={`top:${it.y ?? 0}%`}>
      <span class="tag">{it.stage}</span>
      <div class="row"><span class="v">{it.value}</span><small>{it.of}</small></div>
      <b>{it.metric}</b>
      <p>{it.why}</p>
    </div>
  ))}
</div>
