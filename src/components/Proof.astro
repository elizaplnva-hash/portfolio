---
interface Props { items: { tag: string; text: string }[]; }
const { items } = Astro.props;
---
<div class="prf">
  <p class="prf-h">Where it showed up</p>
  {items.map((it, i) => (
    <div class="prf-r" style={`--i:${i}`}>
      <span class="n" aria-hidden="true">{i + 1}</span>
      <p>{it.text}</p>
      <span class="tag">{it.tag}</span>
    </div>
  ))}
</div>
