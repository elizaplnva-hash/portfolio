---
interface Props { rows: { signal: string; next: string }[]; note?: string; }
const { rows, note } = Astro.props;
---
<div class="itr">
  <span class="tag">From measurement to iteration</span>
  <div class="itr-t">
    <div class="itr-r hd"><span>Signal</span><span>Next step</span></div>
    {rows.map((r, i) => <div class="itr-r" style={`--i:${i}`}><b>{r.signal}</b><span>{r.next}</span></div>)}
  </div>
  {note && <p class="stg-note">{note}</p>}
</div>
