---
interface Props { items: { saw: string; q: string; a: string }[]; }
const { items } = Astro.props;
---
<div class="hy">
  {items.map((it, i) => (
    <div class="hy-r">
      <span class="hy-n" aria-hidden="true">{i + 1}</span>
      <div class="hy-b">
        <p class="hy-saw">We saw: {it.saw}</p>
        <div class="hy-c">
          <p class="hy-q">{it.q}</p>
          <p class="hy-a">{it.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
