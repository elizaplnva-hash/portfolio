---
import '../styles/global.css';
interface Props { title: string; side: 'front' | 'back'; }
const { title, side } = Astro.props;
const description = 'Eliza Popelinova, Senior Product Designer in Vancouver. Product work on the front, brand and visual work on the back.';
---
<!doctype html>
<html lang="en" data-side={side}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={side === 'front' ? '#f3f3f1' : '#171716'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
